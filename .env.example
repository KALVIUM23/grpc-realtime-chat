# Gemini API configuration (Optional - if omitted or empty, server falls back to Ollama or isolated mode)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest

# Redis Pub/Sub configuration (Optional - falls back to memory broker if unavailable)
REDIS_ADDR=redis:6379

# Server configuration
PORT=50051
BACKPRESSURE_POLICY=drop_oldest
CLIENT_BUFFER_SIZE=64
ENABLE_MODERATION=true

